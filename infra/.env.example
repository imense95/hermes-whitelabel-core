# infra/.env.example — copie para infra/.env e preencha.
# Este arquivo configura o COMPOSE (infra), nao os containers de cliente.
# Segredos de cliente ficam em /srv/hermes/<slug>/.env.

BASE_DOMAIN=exemplo.com.br
ACME_EMAIL=voce@exemplo.com.br

PG_DB=app
PG_SUPERUSER=platform
PG_SUPERUSER_PASSWORD=troque-isto

# Raiz dos volumes de cliente (em producao Linux: /srv/hermes).
# No dev Windows aponte para um caminho local, ex.: ./devdata
CLIENT_DATA_ROOT=/srv/hermes

PRODUCT_IMAGE=hermes-whitelabel
PRODUCT_TAG=dev

# Encadeia os arquivos de cliente para que `docker compose up` suba tudo.
COMPOSE_FILE=docker-compose.yml:clients/urban.yml
COMPOSE_PATH_SEPARATOR=:
